# Local systemone server. The checkpoint is selected when starting that server.
LAYA_BASE_URL=http://127.0.0.1:8791
LAYA_MODEL=laya-v10s
LAYA_TIMEOUT_SECONDS=120
# Optional; the local server does not require authentication.
LAYA_API_KEY=
# System1 decision provider. The UI can override this per new task/batch.
SYSTEM1_PROVIDER=laya
SYSTEM1_DEEPSEEK_MODEL=deepseek-flash
SYSTEM1_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
SYSTEM1_DEEPSEEK_TIMEOUT_SECONDS=60
# Optional if TEXT_MODEL_API_KEY below is already an official DeepSeek key.
SYSTEM1_DEEPSEEK_API_KEY=
# Match the checkpoint and MAXOPT argument used by your local v3 server.
# Defaults to ../laya-browser-git/v10s; only tokenizer/config are loaded, never weights.
LAYA_CONTEXT_CHECKPOINT=
LAYA_CONTEXT_MAX_OPTIONS=999
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
